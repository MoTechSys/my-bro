<!--
  Manager ossec.conf snippet - Active Response: delete file flagged by VirusTotal (UC-03)
  Source: S2 pp.16-17 (Linux executable remove-threat.sh) and p.24 (Windows remove-threat.exe)
  Rule 87105 = "VirusTotal: Alert - <file> - N engines detected this file" (built-in).
  Define ONE <command> per OS; the AR block can reference either. Location "local" = run on the agent.
-->
<ossec_config>
  <command>
    <name>remove-threat</name>
    <executable>remove-threat.sh</executable>
    <timeout_allowed>no</timeout_allowed>
  </command>

  <command>
    <name>remove-threat-windows</name>
    <executable>remove-threat.exe</executable>
    <timeout_allowed>no</timeout_allowed>
  </command>

  <active-response>
    <disabled>no</disabled>
    <command>remove-threat</command>
    <location>local</location>
    <rules_id>87105</rules_id>
  </active-response>

  <active-response>
    <disabled>no</disabled>
    <command>remove-threat-windows</command>
    <location>local</location>
    <rules_id>87105</rules_id>
  </active-response>
</ossec_config>
